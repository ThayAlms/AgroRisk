# Execução local junto ao ESP32
PORT=3000
# SERIAL_PORT geralmente não precisa ser definida: a porta é detectada
# automaticamente pelo chip USB-serial (CP210x/CH340). Só defina um valor
# fixo (ex.: COM3) se houver mais de um dispositivo serial plugado.
SERIAL_PORT=
SERIAL_BAUD=115200

# Habilite apenas depois de gravar no ESP32 o protocolo descrito em
# INTEGRACAO_BUZZER_ESP32.md
SERIAL_COMMANDS=0

# Arquitetura em nuvem (não coloque a chave real neste arquivo de exemplo)
CLOUD_API_URL=https://agrorisk-sompo.vercel.app
DEVICE_ID=colheitadeira-01
DEVICE_API_KEY=gere-uma-chave-longa-e-aleatoria
# No Windows, o gateway também aceita AGRORISK_DEVICE_API_KEY no perfil do usuário.
DATABASE_URL=postgresql://usuario:senha@host/banco
APP_SESSION_SECRET=gere-uma-chave-aleatoria-longa-para-as-sessoes

# Alertas no celular do operador (Web Push). Gere o par com: npm run push:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alertas@agrorisk.app
# Minutos de silêncio entre alertas repetidos da mesma severidade (padrão 5)
PUSH_COOLDOWN_MINUTES=5

# Alertas por Telegram (canal individual por operador). Crie o bot no @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=SeuBotAgroRisk
# Valor longo e aleatório: o Telegram o devolve em cada chamada do webhook
TELEGRAM_WEBHOOK_SECRET=
# Endereço público usado no botão "Abrir painel" das mensagens
PUBLIC_APP_URL=https://agrorisk-sompo.vercel.app
