{
  "name": "monitor-colheitadeira",
  "version": "1.0.0",
  "private": true,
  "description": "Dashboard em tempo real para os sensores da colheitadeira",
  "scripts": {
    "test": "node scripts/test-hybrid.js && node scripts/test-risk-fleet.js && node scripts/test-explanation.js && node scripts/test-auth-portfolio.js",
    "train:model": "node --env-file-if-exists=.env.local scripts/train-risk-model.js",
    "start": "node local-server.js",
    "dev": "node --watch local-server.js",
    "gateway": "powershell -NoProfile -ExecutionPolicy Bypass -File gateway/start-gateway.ps1",
    "smoke:cloud": "node --env-file-if-exists=.vercel/.env.production.local scripts/smoke-cloud.js",
    "smoke:hybrid": "node scripts/smoke-hybrid-cloud.js",
    "smoke:analysis": "node --env-file-if-exists=.env.local scripts/smoke-analysis.js",
    "vercel-dev": "vercel dev"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "vercel": "^59.5.0"
  },
  "allowScripts": {
    "@serialport/bindings-cpp@13.0.0": true,
    "esbuild@0.27.0": true
  }
}
